{
  "name": "scan-and-dine-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scan & Dine Omnichannel Restaurant SaaS Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:auth": "cross-env SERVICE_NAME=AUTH PORT=3001 tsx src/server.ts",
    "start:menu": "cross-env SERVICE_NAME=MENU PORT=3002 tsx src/server.ts",
    "start:orders": "cross-env SERVICE_NAME=ORDERS PORT=3003 tsx src/server.ts",
    "start:ws": "cross-env SERVICE_NAME=WS PORT=3005 tsx src/server.ts",
    "clean": "rimraf dist",
    "seed": "tsx scripts/seed.ts",
    "postman:gen": "tsx scripts/generate-postman.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.7",
    "@types/openapi-to-postmanv2": "^5.0.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "openapi-to-postmanv2": "^6.4.3",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
