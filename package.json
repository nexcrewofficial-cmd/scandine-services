{
  "name": "scan-and-dine-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Scan & Dine Omnichannel Restaurant SaaS Platform",
  "workspaces": [
    "apps/server/*",
    "apps/web",
    "apps/waiter",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
