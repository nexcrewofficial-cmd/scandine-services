# ========================================================
# SCAN & DINE GLOBAL ENVIRONMENT VARIABLES
# ========================================================

# General Environment
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/scan-and-dine?retryWrites=true&w=majority

# Redis & Event Bus
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Tokens
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Microservice Ports
PORT_GATEWAY=3000
PORT_AUTH=3001
PORT_MENU=3002
PORT_ORDERS=3003
PORT_WEBSOCKETS=3005

# Frontend Web App Ports
PORT_WEB_CUSTOMER=4000
PORT_WEB_WAITER=4001
PORT_WEB_ADMIN=4002

# Internal Service URLs for Gateway Routing
URL_SERVICE_AUTH=http://localhost:3001
URL_SERVICE_MENU=http://localhost:3002
URL_SERVICE_ORDERS=http://localhost:3003
URL_SERVICE_WEBSOCKETS=http://localhost:3005

# Public API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3005

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Logging
LOG_LEVEL=info
